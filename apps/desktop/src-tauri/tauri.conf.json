{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyRail",
  "version": "0.1.0",
  "identifier": "io.pasters.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "../../scripts/trunk.sh serve --config Trunk.toml",
      "cwd": "..",
      "wait": false
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "../../scripts/trunk.sh build --config Trunk.toml --release",
      "cwd": ".."
    },
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CopyRail",
        "width": 1440,
        "height": 248,
        "minHeight": 148,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; img-src 'self' customprotocol: asset: data:; frame-src data:; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "shortDescription": "A private, visual clipboard workspace built with Rust",
    "macOS": {
      "entitlements": "PasteRS.entitlements"
    },
    "icon": [
      "generated-icons/32x32.png",
      "generated-icons/128x128.png",
      "generated-icons/128x128@2x.png",
      "generated-icons/icon.icns",
      "generated-icons/icon.ico"
    ]
  }
}
